{
  "name": "mimir",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "clean": "rm -rf .next",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:terms": "node scripts/check-forbidden-terms.mjs",
    "start": "node scripts/railway-start.mjs",
    "start:web": "next start",
    "oracle": "tsx --env-file-if-exists=.env.local agents/oracle/index.ts",
    "oracle:challenge": "AUTO_CHALLENGE=1 tsx --env-file-if-exists=.env.local agents/oracle/index.ts",
    "market-creator": "tsx --env-file-if-exists=.env.local agents/market-creator/index.ts",
    "council": "tsx --env-file-if-exists=.env.local agents/council/index.ts",
    "sync": "tsx --env-file-if-exists=.env.local agents/sync/index.ts",
    "traders": "tsx --env-file-if-exists=.env.local agents/traders/index.ts",
    "agents:create-wallets": "tsx scripts/create-agent-wallets.ts --write",
    "agents:faucet": "tsx --env-file-if-exists=.env.local scripts/faucet-and-distribute.ts",
    "agents:fund": "tsx --env-file-if-exists=.env.local scripts/fund-agents.ts",
    "agents:distribute": "tsx --env-file-if-exists=.env.local scripts/fund-from-oracle.ts",
    "agents:funding-plan": "tsx --env-file-if-exists=.env.local scripts/fund-from-oracle.ts --dry-run",
    "agents:balances": "tsx --env-file-if-exists=.env.local scripts/check-agent-balances.ts",
    "dreamdex:provision": "tsx --env-file-if-exists=.env.local scripts/provision-dreamdex.ts",
    "workers": "concurrently --names oracle,creator,council,sync,traders --kill-others-on-fail -c blue,magenta,green,cyan,yellow \"npm:oracle\" \"npm:market-creator\" \"npm:council\" \"npm:sync\" \"npm:traders\"",
    "demo:cycle": "tsx --env-file-if-exists=.env.local scripts/demo-full-cycle.ts",
    "seed": "npx tsx scripts/seed-claims.ts",
    "seed:dry": "DRY_RUN=1 npx tsx scripts/seed-claims.ts",
    "verify:analytics": "tsx scripts/check-analytics-gates.ts",
    "smoke:onchain": "tsx --env-file-if-exists=.env.local scripts/onchain-smoke.ts",
    "test:smoke": "node scripts/run-node-tests.mjs",
    "test:research": "node --import tsx --test tests/node/research-adapters.test.ts tests/node/categories.test.ts tests/node/context-pack.test.ts tests/node/research-ssrf.test.ts tests/node/source-fallback.test.ts tests/node/research-gateway.test.ts tests/node/x402-discovery.test.ts",
    "test:squad": "node --import tsx --test tests/node/squad-view.test.ts tests/node/squad-pool.test.ts",
    "test:baskets": "node --import tsx --test tests/node/baskets.test.ts",
    "test:schema": "node --import tsx --test tests/node/schema-backlog.test.ts",
    "warm:vs-index": "tsx scripts/warm-vs-index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@fontsource/maple-mono": "^5.2.6",
    "@neondatabase/serverless": "^1.1.0",
    "@privy-io/react-auth": "^3.37.1",
    "@privy-io/wagmi": "^4.0.16",
    "@solana-program/token": "0.9.0",
    "@solana-program/token-2022": "0.6.1",
    "@solana/kit": "5.5.1",
    "@solana/rpc-api": "^8.0.0",
    "@solana/transaction-messages": "^8.0.0",
    "@somnia-chain/markets-sdk": "^0.27.0",
    "@stripe/stripe-js": "^9.14.0",
    "@tanstack/react-query": "^5.100.10",
    "@types/ws": "^8.18.1",
    "@wagmi/connectors": "^8.0.25",
    "@wagmi/core": "^3.6.4",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/extensions": "^2.21.0",
    "@x402/fetch": "^2.21.0",
    "@x402/next": "^2.21.0",
    "@xmtp/browser-sdk": "^7.0.0",
    "accounts": "^0.14.12",
    "concurrently": "^9.2.1",
    "framer-motion": "12.39.0",
    "lucide-react": "^0.383.0",
    "motion-dom": "12.39.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "nextjs-toploader": "^3.9.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sonner": "^1.7.0",
    "tsx": "^4.19.0",
    "viem": "^2.47.6",
    "wagmi": "^3.6.15",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "solc": "0.8.28",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "1.18.0"
  }
}
